{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaRetouch",
  "version": "0.0.1",
  "identifier": "co.openlumaretouch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run stage:engine && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaRetouch 精修",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Photography",
    "resources": {
      "gen/engine-stage/lumaretouch_engine": "engine/src/lumaretouch_engine"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64"
        ]
      }
    },
    "shortDescription": "LumaRetouch M0 骨架",
    "longDescription": "Linux AI 人像精修：Tauri 2 宿主 + Python/PyTorch 引擎，裸帧经 POSIX 共享内存上屏（M0 通路骨架）。"
  }
}
