{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumaRetouch",
  "version": "0.9.0",
  "identifier": "co.openlumaretouch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run stage:engine && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LumaRetouch 精修",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Photography",
    "resources": {
      "gen/engine-stage/lumaretouch_engine": "engine/src/lumaretouch_engine",
      "gen/engine-stage/setup-runtime.sh": "engine/setup-runtime.sh",
      "gen/engine-stage/runtime": "engine/runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64"
        ]
      }
    },
    "shortDescription": "LumaRetouch 精修 — Linux AI 人像精修",
    "longDescription": "Linux 原生 AI 人像精修：Tauri 2 宿主 + Python/PyTorch 引擎，预览裸帧经 POSIX 共享内存上屏。质感磨皮（频域分离保留毛孔）、仿中性灰修容、五官微调（TPS）、瑕疵消除笔、3D LUT 与肤色定向调色、全尺寸分块批量导出、底片条多文档与全局撤销/重做。引擎运行时（Python + GPU 版 torch）不进本包，装机后由 /usr/lib/LumaRetouch/engine/setup-runtime.sh 按显卡厂商装对应清单。"
  }
}
