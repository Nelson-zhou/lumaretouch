  "integration_map": {
    "review": "Existing authenticated source canvas + reference proof; separate support protocol, complete member/activeface coverage, staged immutable bank full renders, served pages and exact image ACK.",
    "publication": "Distinct typed support-only authority, selected-pointer exact change, all-member revision and append-only immutable bank transaction, conservative compensation and unknown receipts.",
    "history": "Distinct support marker; exact selected before/after records, own source/crop/repair/support dependencies and complete closure for undo/redo/reopen. No deletion of unrelated historical bank bytes.",
    "native_ui": "Original request/region/reference/bank identity, paged decoded PNGs and ACK; dedicated pending fence, query-only unknown, verified-workspace retirement only. Existing scalar native begin/receive binding reachability corrected.",
    "render_adapter": "portrait_review_render adds optional staged_people_context forwarding; old absent-keyword path and numeric rendering preserved."
  },
  "limitations": [
    "Manual visibility, moderately frontal source geometry, opaque SDR and existing synchronous Rust/work/memory budgets unchanged.",
    "Bounded RGB8 source/comparison displays are not native-resolution or photographic acceptance; original PNG16 master path unchanged.",
    "Only complete available shared-owner 2–16 member sets; dormant/unavailable/hidden source-bearing state without proof refuses.",
    "Mixed-preset aliases and alias effect-recovery painting remain separate guarded gaps; no donor mask/recovery transfer.",
    "Whole-bank history snapshots are not claimed: immutable bytes remain append-only, undo restores selected pointer and exact referenced records/dependencies.",
    "All builds/tests/typecheck/product imports/execution/inference/downloads and runtime/UI/history/quality/performance acceptance UNRUN."
  ],
