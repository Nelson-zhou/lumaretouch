  "integration_map": {
    "cohort": "Automatic source-first complete member review on create/patch/unlink, current graph and retained active faces; exact companion ACKs and original atomic ledger.",
    "alias": "Direct pattern/strength draft, immutable per-document mixed images and original provenance, private scalar-only graph authority, no local state writes or support mutation.",
    "native_ui": "Exact original request correlation, independently verified paged PNG and coverage hashes, each-member decoded-image ACK; no unsafe cross-language float digest assumption.",
    "history": "Protected cohort/alias markers, complete-member scoped undo/redo/reopen; unknown writes query-only and native alias shared-write fence."
  },
  "limitations": [
    "Manual visible-skin support, moderately frontal geometry, opaque SDR and existing synchronous Rust/memory/work budgets unchanged.",
    "Full-source canonical image pairs are reduced RGB8 display evidence, not native-resolution or photographic acceptance.",
    "Alias initial/revised support painting, effect-recovery painting and mixed-preset aliases remain guarded pending exact support/state transactions.",
    "Only complete available 2–16 member alias sets; dormant/unavailable/hidden source-bearing members without proof refuse. Existing cohort target limits remain.",
    "Whole-state batch and unsupported dedicated module mixtures refuse as a whole; no selected effects silently dropped.",
    "All builds/tests/typecheck/product imports/execution/inference/downloads and runtime/native/UI/history/quality/performance acceptance UNRUN."
  ],
