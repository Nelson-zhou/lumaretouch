  "integration_map": {
    "core": "Original eight-layout catalogue and bounded Rust source-pixel area integration, immutable float32 source, separate delta, exact neutral.",
    "ownership": "Authenticated target face_skin plus known and retained foreign-face exclusions, decoration-only source-vector review and source/FaceRef/landmark/PNG proof.",
    "pipeline": "Original and supported derived canonical people render/export/history, stage before common geometry, bounded direction-preserving source-vector composition and effect-only recovery.",
    "native_ui": "Exact people receipt protocol, capability-gated catalogue, real raw source canvas hash/decode and ownership acknowledgments; no second history owner.",
    "presets_transfer": "Original-photo library replay and existing frozen scalar batch/confirmed mappings/persistent associations with target-local support, no copied coordinates/masks. Ordinary derived fullpreset and unsupported aliases remain guarded.",
    "packaging": "Explicit build script and source/licence staging authored, not executed."
  },
  "limitations": [
    "Manual visible-skin review is required; no automatic person-instance or complete occlusion segmentation, proprietary materials or original-mark removal.",
    "Moderately frontal visible faces only; 4M source ROI pixels,64 marks,32M clip-candidate budget; conservative unmeasured memory preflight, no all-resolution performance claim.",
    "Existing opaque SDR portrait path only, no alpha/HDR support added. Source review is RGB8 reduced display, not native-resolution photo acceptance or master quantization.",
    "Generic target scalar preflight/render is not a new dedicated paged photographic batch/cohort ACK workflow.",
    "Ordinary whole-image derived preset replay remains refused; supported derived direct people edits and explicit confirmed mapping are separate routes.",
    "Same-owner shared-source alias mutations remain refused until complete affected-document review exists. Independent copy owners stay separate.",
    "Native solve remains synchronous and bounded; no immediate in-flight cancellation claim.",
    "All tests/build/typecheck/product execution/imports/inference/downloads and runtime/native/UI/history/numerical/photo acceptance UNRUN."
  ],
