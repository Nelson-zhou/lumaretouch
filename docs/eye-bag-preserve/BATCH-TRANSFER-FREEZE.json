  "integration_map": {
    "planner": "eye_bag_batch_plan/review, process-local adapter admission, target-owned retained support and full aggregate rendered candidate; explicit per-target legacy choice, selected legacy conflicts refused",
    "ledger": "existing people_batch_ledger commit/rollback/undo/redo plus eye_bag_batch_history exact membership/dependencies; stable project codec identity, save/load validation and live current capture before replay",
    "images": "eye_bag_batch_store reuses immutable paged PNG store; complete source/repair/support snapshot and per-target coverage digest, compact+image exact hashes; no project or history bitmap payload",
    "protocol": "eye_bag_batch_protocol validates explicit map/coverage/full image/ACK/noop/unknown; batch_history_protocol binds existing correlated undo/redo batch ID without new mutation authority",
    "ui": "per-target explicit policy, full mixed image review and ACK, monotonic read invalidation, exact zero-amount neutral compatibility and reopened protected-history classification",
    "reads": "narrow server/recovery read admission after prior guards; derived image and exact ACK envelope admission does not grant apply authority",
    "dispatch": "batch_dispatch_receipt reports no-write only from exact unstarted server boundary; started writes cannot be reconciled by generic guard helper"
  },
  "limitations": [
    "Manual target protection is not automatic anatomical detection; requirement remains partial.",
    "Only independently reviewed original/derived opaque SDR targets supported by the full renderer; no donor masks, analysis, recovery or source pixels.",
    "Persistent cohorts and generic active transfer stay fenced; unreviewed source aliases and dormant affected documents are not silently admitted.",
    "Full source renders precede bounded RGB8 display reductions; native eye inspection and photo quality are not established by review thumbnails.",
    "All tests/build/typecheck/product execution/imports/inference/downloads and runtime/native/UI/history/numerical/photo acceptance UNRUN."
  ],
