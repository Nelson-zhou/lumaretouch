  "integration_map": {
    "engine": "existing recovery painting/controller with sealed alias candidate admission, staged recovery assets and complete immutable paged full-render member review",
    "dispatch": "prepared identity/digest plus exact retained image/support verification owns all-member fences; no wire flag bypass or duplicate ordinary photo history",
    "derived": "existing actual source pixels/capture/face context guards plus exact versioned alias envelope and retained review verification",
    "ledger": "distinct eye_bag_recovery_alias_review changes only selected recovery pointer; append-only support bank, fullset revision/closure/recipe proof, compensation and canonical project persistence",
    "native": "strict v2 image/display/ACK/receipt binding, correlated fullset history and pending/unknown mutation fencing before raw receipt observation",
    "ui": "paged per-member actual image decode/display and explicit confirmation; noncommittable baseline can unlock drawing, changed gestures require all-member ACK and final confirmation; people-owned group history"
  },
  "limitations": [
    "Official preservation remains partial manual anatomy, and recovery matrix is not wholly implemented or accepted.",
    "Two through sixteen complete live aliases only; dormant/unavailable affected inputs remain refused.",
    "Supported opaque SDR decode/solver limits, existing uint8 recovery coverage; RGB8 reduced review is not HDR/alpha or native pixel acceptance.",
    "First terminal unknown writes remain query-only and fenced until verified project reopening; proven compensation can advance monotonic member revisions and requires fresh review.",
    "No recovery-vector transfer across independent sources; no new generic recovery-render cancellation or other-family alias admission.",
    "All tests/build/typecheck/product execution/imports/inference/downloads and runtime/native/UI/history/numerical/photo acceptance UNRUN."
