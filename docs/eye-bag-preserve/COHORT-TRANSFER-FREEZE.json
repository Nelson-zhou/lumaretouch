  "integration_map": {
    "planner": "people_cross_owner_workflow and eye_bag_cohort_review resolve actual before/after member recipes; retained eye intent and active overrides require dedicated review even generic patch/unlink",
    "ledger": "existing atomic people association ledger plus distinct cohort history marker for exact members, complete persons/links/capsules and canonical source-owned dependencies",
    "images": "eye_bag_cohort_store and shared cohort_image_cache retain identical complete mixed image bytes across independent eye/portrait/collarbone proofs; immutable paged retrieval",
    "protocol": "dedicated native eye_bag_cohort_protocol/review validates source-first member policy, dual support proof, image pairs, exact ACK/scope and strict failure correlation",
    "ui": "persistent association opt-in and automatic known requirement, explicit source/member policy, complete mixed image review/ACK and protected reopened history classification",
    "reads": "narrow server/recovery and derived transport admission after existing guards; exact read shape never grants graph mutation authority",
    "dispatch": "known no-write only from exact unstarted server boundary; started writes retain original query-only uncertainty"
  },
  "limitations": [
    "Manual member protection is not automatic anatomical detection; original requirement remains partial.",
    "Explicit local face overrides retain precedence over shared scalar intent; visually unchanged members still receive actual before/after review.",
    "Only independently owned supported original/derived opaque SDR members, two to sixteen including source; no donor masks, recovery, source pixels or analysis transfer.",
    "Unreviewed source aliases and dormant affected documents remain refused; active before/after needs compatible own support and solver.",
    "RGB8 bounded display reductions are not native-pixel appearance or HDR/alpha support.",
    "All tests/build/typecheck/product execution/imports/inference/downloads and runtime/native/UI/history/numerical/photo acceptance UNRUN."
  ],
